#!/bin/sh
# Variant B launcher (POSIX sh): download pinned Node + app into CLAUDE_PLUGIN_DATA (sha256 verified), exec node.
set -eu
NODE_VER=v22.23.5
HERE=$(cd "$(dirname "$0")" && pwd)
DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.ca-launch}"
APP_URL="https://raw.githubusercontent.com/Arloxians/ca-packaging-spike/main/dist/hello.cjs"
APP_SHA=$(cat "$HERE/app.sha256")
log() { echo "ca-launch: $*" >&2; echo "$(date +%s) $*" >> "$DATA/launch.log"; }
mkdir -p "$DATA"
case "$(uname -s)" in Darwin) OS=darwin;; Linux) OS=linux;; *) log "unsupported OS"; exit 1;; esac
case "$(uname -m)" in arm64|aarch64) ARCH=arm64;; x86_64|amd64) ARCH=x64;; *) log "unsupported arch"; exit 1;; esac
sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
NODE="$DATA/node-$NODE_VER-$OS-$ARCH/bin/node"
APP="$DATA/hello-$APP_SHA.cjs"
if [ ! -x "$NODE" ]; then
  log "start node download"
  TMP=$(mktemp -d "$DATA/tmp.XXXXXX")
  F="node-$NODE_VER-$OS-$ARCH.tar.gz"
  curl -fsSL "https://nodejs.org/dist/$NODE_VER/SHASUMS256.txt" -o "$TMP/SUMS" >&2
  WANT=$(grep "  $F\$" "$TMP/SUMS" | cut -d' ' -f1)
  [ -n "$WANT" ] || { log "no checksum for $F"; exit 1; }
  curl -fsSL "https://nodejs.org/dist/$NODE_VER/$F" -o "$TMP/$F" >&2
  [ "$(sha "$TMP/$F")" = "$WANT" ] || { log "node sha256 mismatch"; exit 1; }
  tar -xzf "$TMP/$F" -C "$TMP" >&2
  mv "$TMP/node-$NODE_VER-$OS-$ARCH" "$DATA/node-$NODE_VER-$OS-$ARCH"
  rm -rf "$TMP"
  log "node ready"
fi
if [ ! -f "$APP" ]; then
  curl -fsSL "$APP_URL" -o "$APP.part" >&2
  [ "$(sha "$APP.part")" = "$APP_SHA" ] || { rm -f "$APP.part"; log "app sha256 mismatch"; exit 1; }
  mv "$APP.part" "$APP"
  log "app ready"
fi
exec "$NODE" "$APP"
